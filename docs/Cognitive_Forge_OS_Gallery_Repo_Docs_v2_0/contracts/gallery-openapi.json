    "schemas": {
      "BenchmarkTask": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "BenchmarkTask",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "expected_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "data_scope": {
            "type": "string",
            "enum": [
              "synthetic_public",
              "owner_private"
            ]
          }
        },
        "required": [
          "task_id",
          "version",
          "agent_id",
          "input",
          "expected_checks",
          "forbidden_outputs",
          "data_scope"
        ]
      },
