                }
              }
            }
          },
          "409": {
            "description": "버전 또는 멱등 키 충돌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AgentApplication": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "AgentApplication",
        "type": "object",
        "required": [
          "app_id",
          "workspace_id",
          "release_id",
          "slug",
          "settings"
        ],
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "type": "object"
          }
        }
      },
      "ArtifactVersion": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ArtifactVersion",
        "type": "object",
        "required": [
          "artifact_id",
          "workspace_id",
          "run_id",
          "version",
          "content_hash",
          "content",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CasePackDefinition": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CasePackDefinition",
        "type": "object",
        "required": [
          "pack_id",
          "version",
          "task",
          "input_schema",
          "output_schema",
          "steps",
          "evaluation_rules"
        ],
        "additionalProperties": false,
        "properties": {
          "pack_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evaluation_rules": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "EvaluationReport": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvaluationReport",
        "type": "object",
        "required": [
          "report_id",
          "run_id",
          "suite_version",
          "status",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "suite_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "not_run",
              "pass",
              "fail",
              "error"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "EventEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EventEnvelope",
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "schema_version",
          "occurred_at",
          "workspace_id",
          "run_id",
          "correlation_id",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "minLength": 1
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "ReleaseManifest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ReleaseManifest",
        "type": "object",
        "required": [
          "release_id",
          "pack_id",
          "pack_version",
          "compiler_version",
          "evaluation_suite_version",
          "content_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "pack_id": {
            "type": "string",
            "minLength": 1
          },
          "pack_version": {
            "type": "string",
            "minLength": 1
          },
          "compiler_version": {
            "type": "string",
            "minLength": 1
          },
          "evaluation_suite_version": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ReviewDecision": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ReviewDecision",
        "type": "object",
        "required": [
          "decision_id",
          "workspace_id",
          "run_id",
          "actor_id",
          "artifact_id",
          "artifact_version",
          "content_hash",
          "decision",
          "expected_revision"
        ],
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_version": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "approve",
              "request_changes",
              "reject"
            ]
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "RunReceipt": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "RunReceipt",
        "type": "object",
        "required": [
          "run_id",
          "workspace_id",
          "release_id",
          "revision",
          "status",
          "artifact_ids",
          "evaluation_status",
          "review_status"
        ],
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "queued",
              "running",
              "waiting_input",
              "waiting_review",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluation_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "not_run",
              "pass",
              "fail",
              "error"
            ]
          },
          "review_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "not_required",
              "pending",
              "approved",
              "changes_requested"
            ]
          }
        }
      },
      "WorkRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WorkRequest",
        "type": "object",
        "required": [
          "request_id",
          "workspace_id",
          "app_id",
          "input",
          "external_reference"
        ],
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "external_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RunCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "external_reference": {
            "type": "string",
            "minLength": 1
          },
          "review_authority": {
            "enum": [
              "native",
              "delegated"
            ]
          }
        },
        "required": [
          "app_id",
          "release_id",
          "input",
          "review_authority"
        ]
      },
      "InputSubmit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "object"
          }
        },
        "required": [
          "expected_revision",
          "input"
        ]
      },
      "CancelRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "expected_revision",
          "reason"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ]
      }
    }
  }
}
