        }
      }
    },
    "/api/v1/runs/{run_id}/cancel": {
      "post": {
        "summary": "취소 요청",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "접수 또는 조회 성공",
            "content": {
              "application/json": {
