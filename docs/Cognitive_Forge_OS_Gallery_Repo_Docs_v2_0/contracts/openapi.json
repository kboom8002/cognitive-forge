                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "버전 또는 멱등 키 충돌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
