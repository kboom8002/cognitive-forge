{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonaProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "persona_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "behavior_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "real_person_impersonation": {
      "const": false
    }
  },
  "required": [
    "persona_id",
    "role",
    "audience",
    "behavior_rules",
    "prohibited_claims",
    "real_person_impersonation"
  ]
}
