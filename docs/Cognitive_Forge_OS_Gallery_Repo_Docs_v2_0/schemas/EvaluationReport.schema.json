{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:EvaluationReport:1",
  "title": "EvaluationReport",
  "type": "object",
  "required": [
    "report_id",
    "run_id",
    "suite_version",
    "status",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "suite_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "not_run",
        "pass",
        "fail",
        "error"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
