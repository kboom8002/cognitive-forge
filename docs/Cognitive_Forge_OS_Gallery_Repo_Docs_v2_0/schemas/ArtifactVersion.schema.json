{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:ArtifactVersion:1",
  "title": "ArtifactVersion",
  "type": "object",
  "required": [
    "artifact_id",
    "workspace_id",
    "run_id",
    "version",
    "content_hash",
    "content",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
