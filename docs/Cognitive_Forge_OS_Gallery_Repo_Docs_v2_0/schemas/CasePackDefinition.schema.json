{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:CasePackDefinition:1",
  "title": "CasePackDefinition",
  "type": "object",
  "required": [
    "pack_id",
    "version",
    "task",
    "input_schema",
    "output_schema",
    "steps",
    "evaluation_rules"
